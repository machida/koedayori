<div class="w-full flex flex-col items-center">
  <%= render "shared/page_title", text: "こえを受け取りたいご家族の新規登録" %>

    <div class="card bg-white rounded-2xl shadow-sm p-8">
        <%= form_with model: @speaker, url: families_speakers_path do |form| %>
                <%= form.label :name %>
                <%= form.text_field :name, class: "input mb-4"%>
            <%= form.submit "登録する", class: "btn btn-primary" %>
        <% end %>
    </div>
</div>