<% content_for(:title, "今日のこえ｜こえだより") %>
<div class="w-full">
  <%= render "shared/success_messages", messages: [flash[:notice]].compact , class: "mb-4" %>
  <%= render "shared/page_title", text: "今日のこえ" %>
  <div class="flex items-center gap-2 text-sm text-base-content/60 mb-2">
    <%= link_to families_speakers_path, class: "btn btn-ghost btn-sm gap-1" do %>
      <%= icon("arrow-path", css_class: "w-4 h-4") %>
      最新の状態に更新
    <% end %>
    <span>最終更新 <%= Time.zone.now.strftime("%H:%M") %></span>
  </div>
  <div class="divider"></div>
  <% unless current_family.speakers.empty? %>

  <details class="collapse collapse-arrow bg-base-100 border border-base-300 mt-4 mb-4" open data-controller="dismissible" data-dismissible-target="details">
    <summary class="collapse-title">はじめに、２つの役割を知ってください。</summary>
    <div class="collapse-content">
      <div class="flex flex-col items-center gap-2 py-2 text-center">
        <div class="flex flex-col items-center gap-1">
          <h2 class="text-lg font-bold mb-3">こえだより の しくみ</h2>
          <div class="bg-primary/10 rounded-full p-3 mb-2">
            <%= icon("user", css_class: "w-8 h-8 text-primary") %>
          </div>
          <span class="badge badge-primary badge-lg my-2">こえを届ける家族</span>
          <p class="text-xs text-base-content/70">例）おじいちゃん・おばあちゃん</p>
        </div>

        <%= icon("arrow-down", css_class: "w-5 h-5 text-base-content/50") %>
        <p class="text-sm font-medium">毎日、専用ページからこえを録音する</p>

        <div class="bg-primary rounded-full px-4 py-2">
          <%= image_tag "koedayori_logo_white.png", alt: "こえだより", class: "h-6" %>
        </div>

        <%= icon("arrow-down", css_class: "w-5 h-5 text-base-content/50") %>
        <p class="text-sm font-medium">こえが届く</p>

        <div class="flex flex-col items-center gap-1">
          <div class="bg-warning/10 rounded-full p-3 mb-2">
            <%= icon("speaker-wave", css_class: "w-8 h-8 text-warning") %>
          </div>
          <span class="badge badge-warning badge-lg my-2">見守る家族</span>
          <p class="text-xs text-base-content/70">例）お子さん・お孫さん</p>

          <div role="alert" class="alert alert-info mt-4">
            <%= icon("information-circle", css_class: "h-6 w-6 shrink-0 stroke-current") %>
            <span>家族の誰かが声を聞くと、「安否確認」ができたことになります</span>
          </div>
        </div>
        <button data-dismissible-target="button" data-action="click->dismissible#click" class="btn btn-soft mt-4 mb-4" >今後表示しない</button>
      </div>
    </div>
  </details>
  <% end %>

  <% if current_family.speakers.empty? %>
  <div class="mb-4">まずは以下のボタンより、見守りたい家族を登録してください。</div>
  <%= link_to "＋　見守りたい家族を追加する", new_families_speaker_path, class: "btn btn-primary text-lg mb-6" %>
  <% end %>
  <ul class="flex flex-col md:flex-row gap-4 flex-wrap items-stretch">
    <% @speakers.each do |speaker| %>
    <% latest_post = speaker.posts.max_by(&:created_at) %>
      <% needs_attention = speaker.status == :needs_attention && speaker.notifications_enabled %>
      <% border_color = needs_attention ? "border-error" : "border-base-300" %>

      <li class="card bg-base-100 border <%= border_color %> shadow-sm w-full md:w-80 transition hover:shadow-lg hover:scale-105 <%= "opacity-50" unless speaker.active? %>">
        <%= link_to families_speaker_posts_path(speaker), class: "card-body" do %>
          <h2 class="card-title"><%= speaker.name %></h2>

            <% if latest_post %>
              <p class="flex items-center gap-1 text-xs text-base-content/60">
                <%= icon("clock", css_class: "w-3 h-3") %>
                <%= latest_post.created_at.strftime("%-m月%-d日 %H:%M") %>に<% if latest_post.theme %>「<%= latest_post.theme.title %>」の<% end %>こえが届きました(最後の録音から<%= time_ago_in_words(latest_post.created_at) %>)
              </p>
            <% else %>
              <p class="text-xs text-base-content/60">まだ録音がありません</p>
            <% end %>

            <% if needs_attention %>
              <div role="alert" class="alert alert-error alert-soft">
                <span><%= speaker.name %>さんからのこえは、今日はまだ届いていません</span>
              </div>
            <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% unless current_family.speakers.empty? %>
  <%= link_to "＋　見守りたい家族を追加する", new_families_speaker_path, class: "btn btn-primary text-lg mt-6" %>
  <% end %>
</div>
