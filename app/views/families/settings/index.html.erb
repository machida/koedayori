<div class="w-full">
  <%= render "shared/page_title", text: "設定" %>
  <div class="divider"></div>
  <%= link_to "祖父母を追加する", new_families_speaker_path, class: "btn btn-primary text-lg mb-6" %>
  <ul class="flex flex-col md:flex-row gap-4 flex-wrap items-stretch">
    <% current_family.speakers.order(active: :desc).each do |speaker| %>
      <li class="card bg-white shadow-sm w-full md:w-80 transition hover:shadow-lg hover:scale-105 <%= "opacity-50" unless speaker.active? %>">
        <div class="card-body">
          <h2 class="card-title"><%= link_to "#{speaker.name} さんのセットアップ", families_speaker_path(speaker) %></h2>
          <div class="divider"></div>
          <div class="text-right">
            <%= link_to "通知設定", edit_families_speaker_path(speaker) %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
  <%= link_to "ダッシュボードに戻る", families_speakers_path, class: "btn btn-ghost w-full mt-4" %>
  <div class="divider"></div>
  <%= link_to "退会する", new_families_withdrawal_path, class: "text-error" %>
</div>
