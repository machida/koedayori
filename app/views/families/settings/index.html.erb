<div>
  <h1 class="font-bold text-4xl">Families::Settings#index</h1>
  <p>Find me in app/views/families/settings/index.html.erb</p>
  <h1>設定画面</h1>

  <%= link_to "祖父母を追加する", new_families_speaker_path %>

  <ul>
    <% current_family.speakers.each do |speaker| %>
      <li>
      <%= link_to speaker.name, families_speaker_path(speaker) %>
      <%= link_to "設定", edit_families_speaker_path(speaker) %>
      </li>
    <% end %>
  </ul>

  <%= link_to "退会する", new_families_withdrawal_path %>
</div>
