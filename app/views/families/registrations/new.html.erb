<div class="w-full flex justify-center items-center">
  <div class="card flex-col items-center gap-8 p-6 bg-base-100 border border-base-300 w-full max-w-2xl">

  <%= render "shared/page_title", text: "新規会員登録" %>
  <p>たいせつなご家族の、たいせつなこえを受け取りませんか。</p>
  <div class="divider my-2"></div>

  <% if @family.errors.any? %>
    <div id="error_explanation">
      <ul class="text-sm w-full text-error">
        <% @family.errors.each do |error| %>
          <li>💡 <%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <%= form_with model: @family, class: "w-full", url: families_registrations_path do |form| %>
      <div>
        <fieldset class="fieldset">
          <div>
            <%= form.label :email, class: "label text-base" %>
            <span class="badge badge-success">必須</span>
          </div>
          <%= form.text_field :email, class: "input mb-4 w-full" , placeholder: "例）taro@example.com"%>
        </fieldset>
      </div>

      <div>
        <fieldset class="fieldset">
          <div>
            <%= form.label :aikotoba, class: "label text-base" %>
            <span class="badge badge-success">必須</span>
          </div>
          <fieldset class="fieldset">
            <p class="label whitespace-normal">あいことばは、複数人でログインするためにご家族間で共有するためのキーワードです。<br>今後、「あいことば」でログインをします。お好みの英数字。</p>
          </fieldset>
          <%= form.text_field :aikotoba, class: "input mb-4 w-full", placeholder: "例）yamadafamily" %>
        </fieldset>
      </div>

      <div>
        <fieldset class="fieldset">
          <div>
            <%= form.label :password, class: "label text-base" %>
            <span class="badge badge-success">必須</span>
          </div>
          <fieldset class="fieldset">
            <p class="label whitespace-normal">半角英数字８文字以上</p>
          </fieldset>
          <%= form.password_field :password, class: "input mb-4 w-full"%>
        </fieldset>
      </div>

      <%= form.submit "登録する", class: "btn btn-primary w-full"%>
    <% end %>
</div>