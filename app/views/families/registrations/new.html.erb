<div>
  <h1 class="font-bold text-4xl">Families::Registrations#new</h1>
  <p>Find me in app/views/families/registrations/new.html.erb</p>
  <div>
    <h1 class="font-bold text-4xl">家族の新規登録</h1>

    <%= form_with model: @family, url: families_registrations_path do |form| %>
      <div>
        <%= form.label :email %>
        <%= form.text_field :email %>
      </div>

      <div>
        <%= form.label :aikotoba %>
        <%= form.text_field :aikotoba%>
      </div>

      <div>
        <%= form.label :password%>
        <%= form.password_field :password%>
      </div>

      <%= form.submit "登録する" %>
    <% end %>
  </div>
</div>