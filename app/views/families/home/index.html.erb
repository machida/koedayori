<div>
  <%= render "shared/page_title", text: "Families::Post#index" %>
  <p>Find me in app/views/families/post/index.html.erb</p>
  <p>ご家族の名前</p>
    <%= @speaker.name %>

<div class="posts-list">
  <% @speaker.posts.each do |post| %>
    <div class="posts-item">
      <%= audio_tag(post.audio, controls: true, data: { controller: "playback", playback_post_id_value: post.id, action: "play->playback#markPlayed"}) %>
      <%= post.created_at %>
      <%= post.played_at? ? "既読" : "未読" %>
    </div>
  <% end %>
</div>

</div>
