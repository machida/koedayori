<div class="w-full flex justify-center items-center">
  <div class="card flex-col items-center gap-8 p-6 bg-base-100 border border-base-300 w-full max-w-2xl">

    <%= render "shared/page_title", text: "ログイン" %>

    <% if flash[:alert] %>
      <div id="error_explanation">
        <ul class="text-sm w-full text-error">
          <li>💡 <%= flash[:alert] %></li>
        </ul>
      </div>
    <% end %>

    <%= form_with url: families_sessions_path, class: "w-full", model: Family.new do |form| %>
      <div>
        <%= form.label :aikotoba, class: "label text-base mb-4"  %>
        <%= form.text_field :aikotoba, class: "input mb-4 w-full" , placeholder: "例）taro@example.com" %>
      </div>

      <div>
        <%= form.label :password, class: "label text-base mb-4" %>
        <%= form.password_field :password , class: "input mb-4 w-full"%>
      </div>

      <%= form.submit "ログイン", class: "btn btn-primary w-full" %>
    <% end %>
  </div>
</div>
