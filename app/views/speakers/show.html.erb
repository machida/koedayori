<div>
  <h1 class="font-bold text-4xl">Speakers#show</h1>
  <p>Find me in app/views/speakers/show.html.erb</p>
    <div data-controller="recording" data-recording-slug-value="<%= params[:slug] %>">
      <h1 class="font-bold text-4xl">吹き込みページ</h1>
      <h2><%= @theme.title %></h2>
      <button data-recording-target="startBtn" data-action="click->recording#start">録音開始</button>
      <button data-recording-target="stopBtn" data-action="click->recording#stop">録音停止</button>
      <audio data-recording-target="player" controls></audio>
    </div>
</div>
