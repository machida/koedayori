<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Koedayori" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Koedayori">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen flex flex-col">
  <% unless content_for?(:hide_header) %>
    <%if current_family %>
    <div class="navbar bg-primary shadow-sm">
      <div class="container mx-auto px-5 flex">
        <div class="navbar-start">
          <%= link_to "こえだより", families_speakers_path, class: "text-xl text-white" %>
        </div>
        <div class="navbar-end gap-4">
          <div class="hidden sm:flex items-center gap-4">
            <%= link_to "ダッシュボード", families_speakers_path, class: "whitespace-nowrap text-s text-neutral-content" %>
            <%= link_to "設定", families_settings_path, class: "whitespace-nowrap text-s text-neutral-content" %>
            <%= current_family ? link_to("ログアウト", families_session_path(current_family), data: { turbo_method: :delete }, class: "whitespace-nowrap btn btn-soft") : link_to("ログイン", new_families_session_path, class: "btn btn-neutral") %>
          </div>

          <div class="dropdown dropdown-end sm:hidden">
            <div tabindex="0" role="button" class="btn btn-ghost text-white text-xl">☰</div>
            <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-box z-10 w-52 p-2 shadow-sm">
              <li><%= link_to "ダッシュボード", families_speakers_path %></li>
              <li><%= link_to "設定", families_settings_path %></li>
              <li><%= current_family ? link_to("ログアウト", families_session_path(current_family), data: { turbo_method: :delete }) : link_to("ログイン", new_families_session_path) %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <% else %>
    <div class="navbar bg-primary shadow-sm">
      <div class="container mx-auto px-5 flex">
        <div class="navbar-start">
          <%= link_to "こえだより", root_path, class: "text-xl text-white" %>
        </div>
        <div class="navbar-end gap-4">
          <div class="flex items-center gap-4">
            <%= link_to("新規登録", new_families_registration_path, class: "btn btn-primary") %>
            <%= link_to("ログイン", new_families_session_path, class: "btn btn-neutral") %>
          </div>
        </div>
      </div>
    </div>
    <% end %>
    <% end %>
    <main class="container mx-auto px-5 flex flex-1 mt-8">
      <%= yield %>
    </main>
  
  <footer class="footer items-center mx-auto container mx-auto px-5 py-6 bg-base-200 text-base-content mt-auto rounded-t-2xl">
  <div class="items-center grid-flow-col">
    <p class="text-sm opacity-70">© 2026 こえだより</p>
  </div>
</footer>

  </body>
</html>
